# API Configuration
API_HOST=0.0.0.0
API_PORT=8000
API_DEBUG=True

# KIMI 2 API Configuration (Moonshot AI)
KIMI_API_KEY=your_kimi_api_key_here
KIMI_API_BASE=https://api.moonshot.cn/v1
KIMI_MODEL=moonshot-v1-32k

# LLAMA 3.2 API Configuration (Together AI / Groq / Replicate)
LLAMA_API_KEY=your_llama_api_key_here
LLAMA_API_BASE=https://api.together.xyz/v1
LLAMA_MODEL=meta-llama/Llama-3.2-90B-Vision-Instruct

# Database
DATABASE_URL=sqlite+aiosqlite:///./yoga_diet.db

# JWT Secret
JWT_SECRET=your_super_secret_jwt_key_change_this_in_production
JWT_ALGORITHM=HS256
JWT_EXPIRATION_HOURS=24

# Redis (for caching and task queue)
REDIS_URL=redis://localhost:6379/0

# Feature Flags
ENABLE_YOGA_AGENT=True
ENABLE_DIET_AGENT=True
ENABLE_ANALYTICS=True
ENABLE_NOTIFICATIONS=True
